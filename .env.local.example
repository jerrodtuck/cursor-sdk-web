# Optional for local development only — avoids re-pasting your key on every refresh.
# Production deployments should NOT set this; users connect their own key in the demo UI.
#
# Get a key at https://cursor.com/dashboard/integrations

# CURSOR_API_KEY=cursor_...

# Optional: override the GitHub link shown in header/footer
# NEXT_PUBLIC_REPO_URL=https://github.com/jerrodtuck/cursor-sdk-web
